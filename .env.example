# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are inlined at build time: set them in the hosting
# provider too, and redeploy after changing them.

# Existing: GraphQL API (Apollo client) and environment flag
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_NODE_ENV=

# Dreamfox Contact Us form -> Virtuos CMS public form API
# (see dreamfox-contact-us-fe-handover.md)
# Public identifiers sent by the browser, not secrets. The Turnstile SECRET key
# stays on the backend only and must never be added to this file.
NEXT_PUBLIC_DREAMFOX_API_BASE_URL=
NEXT_PUBLIC_DREAMFOX_WEBSITE_UUID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
